# Configuración de Django para Railway
# Copia este contenido a un archivo .env en tu proyecto local

SECRET_KEY=tu-clave-secreta-muy-larga-y-segura-para-railway-123456789
DEBUG=False
DJANGO_SETTINGS_MODULE=calendario_reservas.settings_production
ALLOWED_HOSTS=tu-app.railway.app

# Base de datos PostgreSQL (Railway las genera automáticamente)
# Estas variables las proporcionará Railway automáticamente cuando agregues PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@host:port/database
# DB_NAME=railway
# DB_USER=postgres  
# DB_PASSWORD=generado-por-railway
# DB_HOST=containers-us-west-xxx.railway.app
# DB_PORT=5432

# Cache Redis (opcional - solo si agregas Redis)
# REDIS_URL=redis://default:password@host:port

# Configuración de email (opcional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
# DEFAULT_FROM_EMAIL=noreply@tu-dominio.com
