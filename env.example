# Configuración de Django
SECRET_KEY=solo-desarrollo-genera-una-clave-aleatoria-para-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ===== OPCIÓN 1: Base de datos PostgreSQL Local =====
DB_NAME=calendario_db
DB_USER=postgres
DB_PASSWORD=tu-password-postgres
DB_HOST=localhost
DB_PORT=5432

# ===== OPCIÓN 2: Supabase (Recomendado para producción) =====
# Usar el pooler en modo Transaction (puerto 6543), no Session (5432).
# Opción 2A: Usar DATABASE_URL completa (más simple)
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:tu-password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opción 2B: Usar variables individuales de Supabase
# SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.xxxxxxxxxxxxx
# SUPABASE_DB_PASSWORD=tu-password-supabase
# SUPABASE_DB_PORT=6543

# ===== OPCIÓN 3: Railway u otro servicio =====
# DATABASE_URL=postgresql://usuario:password@host:5432/database

# ===== Configuración de Email (opcional) =====
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-email@gmail.com
# EMAIL_HOST_PASSWORD=tu-password

# ===== Configuración para Producción =====
# DJANGO_SETTINGS_MODULE=calendario_reservas.settings_production
# ALLOWED_HOSTS=tu-dominio.com
# CSRF_TRUSTED_ORIGINS=https://tu-dominio.com
# Vercel agrega automáticamente los dominios de este proyecto desde VERCEL_*_URL.
# REDIS_URL=rediss://usuario:password@host:6379/0
# Redis comparte los límites de solicitudes entre instancias de producción.
