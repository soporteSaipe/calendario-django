# Variables de entorno para Vercel
# Copiar estas variables en: Vercel Dashboard → Project → Settings → Environment Variables
# Completar los valores reales solamente en Vercel o en `.env.vercel.local`.
# Nunca versionar credenciales en este archivo.

DJANGO_SETTINGS_MODULE=calendario_reservas.settings_production
SECRET_KEY=<tu-clave-secreta>
DEBUG=False

# Reemplazar <tu-proyecto> con el nombre real de tu app en Vercel
ALLOWED_HOSTS=calendariosaipe.vercel.app,.vercel.app
CSRF_TRUSTED_ORIGINS=https://calendariosaipe.vercel.app,https://*.vercel.app

# PostgreSQL externo (Supabase, Neon, Vercel Postgres, etc.)
DATABASE_URL=postgresql://usuario:<password>@<host>:6543/postgres

# Alternativa Supabase (si no usás DATABASE_URL directamente)
# SUPABASE_DB_HOST=<host>.pooler.supabase.com
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=<password>
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_PORT=6543
